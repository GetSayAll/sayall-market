{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getsayall.com/schemas/v1/market-feed.schema.json",
  "title": "SayAll market feed 1.0",
  "description": "Public external-link feed for the SayAll open market page.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "entries"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "status": {
      "const": "draft"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "titleEn",
        "description",
        "descriptionEn",
        "type",
        "typeEn",
        "addedAt",
        "url",
        "imageUrl",
        "imageAlt",
        "imageAltEn",
        "imageWidth",
        "imageHeight"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "titleEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "descriptionEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "type": {
          "enum": ["外壳", "底座", "收纳", "支架"]
        },
        "typeEn": {
          "enum": ["Shell", "Base", "Storage", "Mount"]
        },
        "addedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://makerworld\\.com\\.cn/(?:zh/)?models/\\d+[A-Za-z0-9-]*\\?[^\\s#]+(?:#[^\\s]+)?$"
        },
        "imageUrl": {
          "type": "string",
          "pattern": "^https://makerworld\\.bblmw\\.cn/makerworld/model/[A-Za-z0-9]+/design/[^\\s]+\\.(?:jpg|jpeg|png)\\?x-oss-process=image/resize,w_1000/format,webp/ignore-error,1$"
        },
        "imageAlt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "imageAltEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "imageWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "imageHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    }
  }
}
