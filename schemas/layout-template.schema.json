{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getsayall.com/schemas/draft/layout-template.schema.json",
  "title": "DRAFT SayAll Remote Layout Template",
  "description": "DRAFT — Not an implementation contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "layoutID", "version", "name", "remoteModel", "bindings"],
  "properties": {
    "schemaVersion": { "const": "0.1-draft" },
    "layoutID": { "type": "string", "minLength": 8, "maxLength": 128 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "remoteModel": { "type": "string", "minLength": 2, "maxLength": 100 },
    "minimumRemoteMicVersion": { "type": "string" },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["controlID", "gesture", "target"],
        "properties": {
          "controlID": { "type": "string", "minLength": 1, "maxLength": 80 },
          "gesture": { "enum": ["singlePress", "doublePress", "longPress"] },
          "target": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "macroID"],
                "properties": {
                  "kind": { "const": "macro" },
                  "macroID": { "type": "string" },
                  "versionRequirement": { "type": "string" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "actionID"],
                "properties": {
                  "kind": { "const": "builtIn" },
                  "actionID": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    }
  }
}
