{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getsayall.com/schemas/draft/layout-template.schema.json",
  "title": "DRAFT SayAll Remote Layout Template",
  "description": "DRAFT — Not an implementation contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "layoutID",
    "version",
    "name",
    "remoteModel",
    "minimumRemoteMicVersion",
    "platforms",
    "bindings"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1-draft" },
    "layoutID": { "$ref": "#/$defs/contentIdentifier" },
    "version": { "$ref": "#/$defs/semanticVersion" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "summary": { "type": "string", "maxLength": 300 },
    "remoteModel": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "minimumRemoteMicVersion": { "$ref": "#/$defs/semanticVersion" },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["macOS", "Windows"] }
    },
    "targetApplication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "bundleIdentifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(\\.[A-Za-z0-9][A-Za-z0-9-]*)+$"
        },
        "documentType": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/binding" }
    }
  },
  "$defs": {
    "contentIdentifier": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlID", "gesture", "target"],
      "properties": {
        "controlID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "gesture": { "enum": ["singlePress", "doublePress", "triplePress", "longPress"] },
        "target": {
          "oneOf": [
            { "$ref": "#/$defs/macroTarget" },
            { "$ref": "#/$defs/builtInTarget" },
            { "$ref": "#/$defs/shortcutTarget" }
          ]
        }
      }
    },
    "macroTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "macroID", "versionRequirement"],
      "properties": {
        "kind": { "const": "macro" },
        "macroID": { "$ref": "#/$defs/contentIdentifier" },
        "versionRequirement": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.(?:[0-9]+|x)$"
        }
      }
    },
    "builtInTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actionID"],
      "properties": {
        "kind": { "const": "builtIn" },
        "actionID": {
          "enum": ["escape", "playPause", "volumeUp", "volumeDown", "mute"]
        }
      }
    },
    "shortcutTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "key", "modifiers"],
      "properties": {
        "kind": { "const": "shortcut" },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "modifiers": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["command", "control", "option", "shift", "function"] }
        }
      }
    }
  }
}
