{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getsayall.com/schemas/draft/macro-package.schema.json",
  "title": "DRAFT SayAll Macro Package",
  "description": "DRAFT — Not an implementation contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "macroID", "version", "name", "scope", "steps"],
  "properties": {
    "schemaVersion": { "const": "0.1-draft" },
    "macroID": { "$ref": "#/$defs/contentIdentifier" },
    "version": { "$ref": "#/$defs/semanticVersion" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "summary": { "type": "string", "maxLength": 300 },
    "scope": {
      "oneOf": [
        { "$ref": "#/$defs/globalScope" },
        { "$ref": "#/$defs/applicationScope" }
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/openApplicationStep" },
          { "$ref": "#/$defs/waitForApplicationStep" },
          { "$ref": "#/$defs/focusLearnedTargetStep" },
          { "$ref": "#/$defs/sendKeyboardShortcutStep" },
          { "$ref": "#/$defs/builtInActionStep" }
        ]
      }
    }
  },
  "$defs": {
    "contentIdentifier": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "bundleIdentifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "globalScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "global" }
      }
    },
    "applicationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "bundleIdentifiers"],
      "properties": {
        "kind": { "const": "application" },
        "bundleIdentifiers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/bundleIdentifier" }
        }
      }
    },
    "stepBase": {
      "type": "object",
      "required": ["stepID", "action", "parameters"],
      "properties": {
        "stepID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "timeoutMilliseconds": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        },
        "action": { "type": "string" },
        "parameters": { "type": "object" }
      }
    },
    "openApplicationStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/stepBase" },
        {
          "properties": {
            "action": { "const": "openApplication" },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bundleIdentifier"],
              "properties": {
                "bundleIdentifier": { "$ref": "#/$defs/bundleIdentifier" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "waitForApplicationStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/stepBase" },
        {
          "properties": {
            "action": { "const": "waitForApplication" },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bundleIdentifier", "state"],
              "properties": {
                "bundleIdentifier": { "$ref": "#/$defs/bundleIdentifier" },
                "state": { "enum": ["running", "frontmost", "frontmostWindow"] }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "focusLearnedTargetStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/stepBase" },
        {
          "properties": {
            "action": { "const": "focusLearnedTarget" },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bundleIdentifier", "localProfileKey"],
              "properties": {
                "bundleIdentifier": { "$ref": "#/$defs/bundleIdentifier" },
                "localProfileKey": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 120,
                  "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "sendKeyboardShortcutStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/stepBase" },
        {
          "properties": {
            "action": { "const": "sendKeyboardShortcut" },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["modifiers", "key"],
              "properties": {
                "modifiers": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "uniqueItems": true,
                  "items": { "enum": ["command", "control", "option", "shift", "function"] }
                },
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24,
                  "pattern": "^[A-Za-z0-9 -]+$"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "builtInActionStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/stepBase" },
        {
          "properties": {
            "action": { "const": "builtInAction" },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["actionID"],
              "properties": {
                "actionID": {
                  "enum": ["escape", "playPause", "volumeUp", "volumeDown", "mute"]
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
