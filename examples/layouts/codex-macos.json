{
  "schemaVersion": "0.1-draft",
  "layoutID": "com.getsayall.example.codex-macos",
  "version": "0.1.0",
  "name": "Codex · macOS",
  "remoteModel": "xiaomi-remote-2-pro",
  "minimumRemoteMicVersion": "1.8.3",
  "platforms": [
    "macOS"
  ],
  "targetApplication": {
    "displayName": "Codex",
    "bundleIdentifier": "com.openai.codex",
