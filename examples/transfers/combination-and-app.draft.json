{
  "format": "sayall-transfer",
  "schemaVersion": "0.2-draft",
  "packageID": "com.getsayall.example.combination-and-app",
  "version": "1.0.0",
  "minimumRemoteMicVersion": "1.9.21",
  "exportPurpose": "share",
  "roots": [
    {
      "kind": "macro",
      "id": "example.root"
    },
    {
      "kind": "application",
      "id": "example.editor"
    }
  ],
  "macros": [
    {
      "schemaVersion": "0.3-draft",
      "macroID": "example.root",
      "version": "1.0.0",
      "name": "打开编辑器并执行子动作",
      "scope": {
        "kind": "global"
      },
      "steps": [
        {
          "stepID": "open",
          "action": "openApplication",
          "parameters": {
            "bundleIdentifier": "com.example.editor"
          }
        },
        {
          "stepID": "child",
          "action": "runMacro",
          "parameters": {
            "nestedMacroID": "example.child",
            "nestedMacroName": "发送快捷键"
          }
        }
      ]
    },
    {
      "schemaVersion": "0.3-draft",
      "macroID": "example.child",
      "version": "2.0.0",
      "name": "发送快捷键",
      "steps": [
        {
          "stepID": "send",
          "action": "sendKeyboardShortcut",
          "parameters": {
            "shortcutProfileKey": "example.shortcut"
          }
        }
      ]
    }
  ],
  "shortcuts": [
    {
      "id": "example.shortcut",
      "displayName": "聚焦输入框",
      "keyCode": 37,
      "keyLabel": "L",
      "modifiers": [
        "command"
      ]
    }
  ],
  "focusTargets": [],
  "applications": [
    {
      "id": "example.editor",
      "displayName": "示例编辑器",
      "bundleIdentifier": "com.example.editor",
      "focusStrategy": "keyboardShortcut",
      "shortcutID": "example.shortcut"
    }
  ],
  "buttonProfiles": []
}
