{
  "format": "sayall-transfer",
  "packageID": "com.getsayall.example.combination-and-app",
  "version": "1.0.0",
  "exportPurpose": "share",
  "schemaVersion": "1.0",
  "type": "macro",
  "macro": {
    "schemaVersion": "1.0",
    "macroID": "example.root",
    "version": "1.0.0",
    "name": "打开编辑器并执行子动作",
    "scope": {
      "kind": "global"
    },
    "steps": [
      {
        "stepID": "open",
        "action": "openApplication",
        "parameters": {
          "bundleIdentifier": "com.example.editor"
        }
      },
      {
        "stepID": "child",
        "action": "runMacro",
        "parameters": {
          "nestedMacroID": "example.child",
          "nestedMacroName": "发送快捷键"
        }
      }
    ]
  },
  "dependencies": {
    "macros": [
      {
        "schemaVersion": "1.0",
        "macroID": "example.child",
        "version": "2.0.0",
        "name": "发送快捷键",
        "steps": [
          {
            "stepID": "send",
            "action": "sendKeyboardShortcut",
            "parameters": {
              "shortcutProfileKey": "example.shortcut"
            }
          }
        ]
      }
    ],
    "shortcuts": [
      {
        "id": "example.shortcut",
        "displayName": "聚焦输入框",
        "keyCode": 37,
        "keyLabel": "L",
        "modifiers": [
          "command"
        ]
      }
    ],
    "focusTargets": [],
    "applications": [
      {
        "id": "example.editor",
        "displayName": "示例编辑器",
        "bundleIdentifier": "com.example.editor",
        "focusStrategy": "keyboardShortcut",
        "shortcutID": "example.shortcut"
      }
    ]
  },
  "requirements": {
    "minimumRemoteMicVersion": "1.9.21",
    "minimumReaderVersion": "1.0",
    "capabilities": []
  }
}
