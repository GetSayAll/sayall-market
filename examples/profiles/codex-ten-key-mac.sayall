{
  "format": "sayall-transfer",
  "website": "https://sayall.app/market/",
  "github": "https://github.com/GetSayAll/sayall-market",
  "packageID": "com.getsayall.candidate.codex-ten-key",
  "version": "0.1.3",
  "exportPurpose": "share",
  "schemaVersion": "1.0",
  "type": "buttonProfile",
  "profile": {
    "id": "com.getsayall.candidate.codex-ten-key",
    "name": "Codex",
    "remoteModel": "xiaomi-remote-2-pro",
    "mode": "automatic",
    "applicationBundleIdentifiers": [
      "com.openai.codex"
    ],
    "bindings": [
      {
        "controlID": "up",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.codex-ten-key.up"
        }
      },
      {
        "controlID": "down",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.codex-ten-key.down"
        }
      },
      {
        "controlID": "left",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.codex-ten-key.left"
        }
      },
      {
        "controlID": "right",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.codex-ten-key.right"
        }
      },
      {
        "controlID": "ok",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.codex-ten-key.ok"
        }
      },
      {
        "controlID": "back",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.codex-ten-key.back"
        }
      },
      {
        "controlID": "home",
        "gesture": "singlePress",
        "target": {
          "kind": "disabled"
        }
      },
      {
        "controlID": "volume-up",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.codex-ten-key.volume-up"
        }
      },
      {
        "controlID": "volume-down",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.codex-ten-key.volume-down"
        }
      },
      {
        "controlID": "power",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.codex-ten-key.power"
        }
      }
    ]
  },
  "dependencies": {
    "macros": [],
    "shortcuts": [
      {
        "id": "com.getsayall.candidate.codex-ten-key.up",
        "displayName": "补充指令",
        "keyCode": 36,
        "keyLabel": "Return",
        "modifiers": [
          "command"
        ]
      },
      {
        "id": "com.getsayall.candidate.codex-ten-key.left",
        "displayName": "上一个会话",
        "keyCode": 48,
        "keyLabel": "Tab",
        "modifiers": [
          "control",
          "shift"
        ]
      },
      {
        "id": "com.getsayall.candidate.codex-ten-key.right",
        "displayName": "下一个会话",
        "keyCode": 48,
        "keyLabel": "Tab",
        "modifiers": [
          "control"
        ]
      },
      {
        "id": "com.getsayall.candidate.codex-ten-key.down",
        "displayName": "在会话中查找",
        "keyCode": 3,
        "keyLabel": "F",
        "modifiers": [
          "command"
        ]
      },
      {
        "id": "com.getsayall.candidate.codex-ten-key.ok",
        "displayName": "提交 / 确认",
        "keyCode": 36,
        "keyLabel": "Return",
        "modifiers": []
      },
      {
        "id": "com.getsayall.candidate.codex-ten-key.back",
        "displayName": "删除字符",
        "keyCode": 51,
        "keyLabel": "Backspace",
        "modifiers": []
      },
      {
        "id": "com.getsayall.candidate.codex-ten-key.volume-up",
        "displayName": "向上翻页",
        "keyCode": 116,
        "keyLabel": "Page Up",
        "modifiers": []
      },
      {
        "id": "com.getsayall.candidate.codex-ten-key.volume-down",
        "displayName": "向下翻页",
        "keyCode": 121,
        "keyLabel": "Page Down",
        "modifiers": []
      },
      {
        "id": "com.getsayall.candidate.codex-ten-key.power",
        "displayName": "停止 / 取消",
        "keyCode": 53,
        "keyLabel": "Esc",
        "modifiers": []
      }
    ],
    "focusTargets": [],
    "applications": []
  },
  "requirements": {
    "minimumRemoteMicVersion": "1.9.21",
    "minimumReaderVersion": "1.0",
    "capabilities": []
  },
  "extensions": {
    "app.sayall:platform": {
      "platform": "macOS"
    }
  }
}
