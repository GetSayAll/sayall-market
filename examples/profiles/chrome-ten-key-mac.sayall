{
  "format": "sayall-transfer",
  "website": "https://sayall.app/market/",
  "github": "https://github.com/GetSayAll/sayall-market",
  "packageID": "com.getsayall.candidate.chrome-ten-key",
  "version": "0.1.2",
  "exportPurpose": "share",
  "schemaVersion": "1.0",
  "type": "buttonProfile",
  "profile": {
    "id": "com.getsayall.candidate.chrome-ten-key",
    "name": "Chrome 10键",
    "remoteModel": "xiaomi-remote-2-pro",
    "mode": "automatic",
    "applicationBundleIdentifiers": [
      "com.google.Chrome"
    ],
    "bindings": [
      {
        "controlID": "up",
        "gesture": "singlePress",
        "target": {
          "kind": "host",
          "actionID": "pageUp"
        }
      },
      {
        "controlID": "down",
        "gesture": "singlePress",
        "target": {
          "kind": "host",
          "actionID": "pageDown"
        }
      },
      {
        "controlID": "left",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.chrome-ten-key.left"
        }
      },
      {
        "controlID": "right",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.chrome-ten-key.right"
        }
      },
      {
        "controlID": "ok",
        "gesture": "singlePress",
        "target": {
          "kind": "disabled"
        }
      },
      {
        "controlID": "back",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.chrome-ten-key.back"
        }
      },
      {
        "controlID": "back",
        "gesture": "longPress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.chrome-ten-key.back-reopen"
        }
      },
      {
        "controlID": "home",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.chrome-ten-key.home"
        }
      },
      {
        "controlID": "volume-up",
        "gesture": "singlePress",
        "target": {
          "kind": "host",
          "actionID": "scrollToTop"
        }
      },
      {
        "controlID": "volume-down",
        "gesture": "singlePress",
        "target": {
          "kind": "host",
          "actionID": "scrollToBottom"
        }
      },
      {
        "controlID": "power",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.chrome-ten-key.power"
        }
      }
    ],
    "holdModes": {
      "back": "once"
    }
  },
  "dependencies": {
    "macros": [],
    "shortcuts": [
      {
        "id": "com.getsayall.candidate.chrome-ten-key.left",
        "displayName": "上一个标签页",
        "keyCode": 123,
        "keyLabel": "←",
        "modifiers": [
          "command",
          "option"
        ]
      },
      {
        "id": "com.getsayall.candidate.chrome-ten-key.right",
        "displayName": "下一个标签页",
        "keyCode": 124,
        "keyLabel": "→",
        "modifiers": [
          "command",
          "option"
        ]
      },
      {
        "id": "com.getsayall.candidate.chrome-ten-key.back",
        "displayName": "新建标签页",
        "keyCode": 17,
        "keyLabel": "T",
        "modifiers": [
          "command"
        ]
      },
      {
        "id": "com.getsayall.candidate.chrome-ten-key.back-reopen",
        "displayName": "重新打开关闭的标签页",
        "keyCode": 17,
        "keyLabel": "T",
        "modifiers": [
          "command",
          "shift"
        ]
      },
      {
        "id": "com.getsayall.candidate.chrome-ten-key.home",
        "displayName": "打开主页",
        "keyCode": 4,
        "keyLabel": "H",
        "modifiers": [
          "command",
          "shift"
        ]
      },
      {
        "id": "com.getsayall.candidate.chrome-ten-key.power",
        "displayName": "关闭当前标签页",
        "keyCode": 13,
        "keyLabel": "W",
        "modifiers": [
          "command"
        ]
      }
    ],
    "focusTargets": [],
    "applications": []
  },
  "requirements": {
    "minimumRemoteMicVersion": "1.9.21",
    "minimumReaderVersion": "1.0",
    "capabilities": [
      "buttonHoldModes"
    ]
  },
  "extensions": {
    "app.sayall:platform": {
      "platform": "macOS"
    }
  }
}
