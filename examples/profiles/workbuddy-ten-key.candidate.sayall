{
  "format": "sayall-transfer",
  "website": "https://sayall.app/market/",
  "github": "https://github.com/GetSayAll/sayall-market",
  "packageID": "com.getsayall.candidate.workbuddy-ten-key",
  "version": "0.1.0",
  "exportPurpose": "share",
  "schemaVersion": "1.0",
  "type": "buttonProfile",
  "profile": {
    "id": "com.getsayall.candidate.workbuddy-ten-key",
    "name": "WorkBuddy 10键",
    "remoteModel": "xiaomi-remote-2-pro",
    "mode": "automatic",
    "applicationBundleIdentifiers": [
      "com.tencent.workbuddy.mac",
      "com.workbuddy.workbuddy"
    ],
    "bindings": [
      {
        "controlID": "up",
        "gesture": "singlePress",
        "target": {
          "kind": "disabled"
        }
      },
      {
        "controlID": "down",
        "gesture": "singlePress",
        "target": {
          "kind": "disabled"
        }
      },
      {
        "controlID": "left",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.workbuddy-ten-key.left"
        }
      },
      {
        "controlID": "right",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.workbuddy-ten-key.right"
        }
      },
      {
        "controlID": "ok",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.workbuddy-ten-key.ok"
        }
      },
      {
        "controlID": "back",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.workbuddy-ten-key.back"
        }
      },
      {
        "controlID": "home",
        "gesture": "singlePress",
        "target": {
          "kind": "disabled"
        }
      },
      {
        "controlID": "volume-up",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.workbuddy-ten-key.volume-up"
        }
      },
      {
        "controlID": "volume-down",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.workbuddy-ten-key.volume-down"
        }
      },
      {
        "controlID": "power",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.workbuddy-ten-key.power"
        }
      }
    ]
  },
  "dependencies": {
    "macros": [],
    "shortcuts": [
      {
        "id": "com.getsayall.candidate.workbuddy-ten-key.left",
        "displayName": "上一个任务（方向待验）",
        "keyCode": 33,
        "keyLabel": "[",
        "modifiers": [
          "command"
        ]
      },
      {
        "id": "com.getsayall.candidate.workbuddy-ten-key.right",
        "displayName": "下一个任务（方向待验）",
        "keyCode": 30,
        "keyLabel": "]",
        "modifiers": [
          "command"
        ]
      },
      {
        "id": "com.getsayall.candidate.workbuddy-ten-key.ok",
        "displayName": "提交 / 确认",
        "keyCode": 36,
        "keyLabel": "Return",
        "modifiers": []
      },
      {
        "id": "com.getsayall.candidate.workbuddy-ten-key.back",
        "displayName": "删除光标前的字符",
        "keyCode": 51,
        "keyLabel": "Backspace",
        "modifiers": []
      },
      {
        "id": "com.getsayall.candidate.workbuddy-ten-key.volume-up",
        "displayName": "向上翻一屏",
        "keyCode": 116,
        "keyLabel": "Page Up",
        "modifiers": []
      },
      {
        "id": "com.getsayall.candidate.workbuddy-ten-key.volume-down",
        "displayName": "向下翻一屏",
        "keyCode": 121,
        "keyLabel": "Page Down",
        "modifiers": []
      },
      {
        "id": "com.getsayall.candidate.workbuddy-ten-key.power",
        "displayName": "停止生成",
        "keyCode": 53,
        "keyLabel": "Esc",
        "modifiers": []
      }
    ],
    "focusTargets": [],
    "applications": []
  },
  "requirements": {
    "minimumRemoteMicVersion": "1.9.21",
    "minimumReaderVersion": "1.0",
    "capabilities": []
  }
}
