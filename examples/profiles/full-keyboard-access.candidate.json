    {
      "id": "full-keyboard-access.arrow-right",
      "displayName": "向右移动",
      "keyCode": 124,
      "keyLabel": "→",
      "modifiers": []
    },
    {
      "id": "full-keyboard-access.space",
      "displayName": "执行当前项目",
      "keyCode": 49,
      "keyLabel": "Space",
      "modifiers": []
    },
    {
      "id": "full-keyboard-access.escape",
      "displayName": "返回或取消",
      "keyCode": 53,
      "keyLabel": "Esc",
      "modifiers": []
    }
  ],
  "focusTargets": [],
  "applications": [],
  "buttonProfiles": [
    {
      "id": "full-keyboard-access-rc003",
