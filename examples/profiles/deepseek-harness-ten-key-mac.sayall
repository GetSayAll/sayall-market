{
  "format": "sayall-transfer",
  "website": "https://sayall.app/market/",
  "github": "https://github.com/GetSayAll/sayall-market",
  "packageID": "com.getsayall.candidate.deepseek-harness-ten-key",
  "version": "0.1.2",
  "exportPurpose": "share",
  "schemaVersion": "1.0",
  "type": "buttonProfile",
  "profile": {
    "id": "com.getsayall.candidate.deepseek-harness-ten-key",
    "name": "DeepSeek Harness",
    "remoteModel": "xiaomi-remote-2-pro",
    "mode": "automatic",
    "applicationBundleIdentifiers": [
      "com.deepseek.dsh"
    ],
    "bindings": [
      {
        "controlID": "up",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.deepseek-harness-ten-key.up"
        }
      },
      {
        "controlID": "down",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.deepseek-harness-ten-key.down"
        }
      },
      {
        "controlID": "left",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.deepseek-harness-ten-key.session-switch"
        }
      },
      {
        "controlID": "right",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.deepseek-harness-ten-key.session-switch"
        }
      },
      {
        "controlID": "ok",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.deepseek-harness-ten-key.ok"
        }
      },
      {
        "controlID": "back",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.deepseek-harness-ten-key.back"
        }
      },
      {
        "controlID": "home",
        "gesture": "singlePress",
        "target": {
          "kind": "disabled"
        }
      },
      {
        "controlID": "volume-up",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.deepseek-harness-ten-key.volume-up"
        }
      },
      {
        "controlID": "volume-down",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.deepseek-harness-ten-key.volume-down"
        }
      },
      {
        "controlID": "power",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.deepseek-harness-ten-key.power"
        }
      }
    ]
  },
  "dependencies": {
    "macros": [],
    "shortcuts": [
      {
        "id": "com.getsayall.candidate.deepseek-harness-ten-key.up",
        "displayName": "运行中插话",
        "keyCode": 36,
        "keyLabel": "Return",
        "modifiers": [
          "command"
        ]
      },
      {
        "id": "com.getsayall.candidate.deepseek-harness-ten-key.session-switch",
        "displayName": "会话快速切换",
        "keyCode": 40,
        "keyLabel": "K",
        "modifiers": [
          "command"
        ]
      },
      {
        "id": "com.getsayall.candidate.deepseek-harness-ten-key.down",
        "displayName": "查找会话内容",
        "keyCode": 3,
        "keyLabel": "F",
        "modifiers": [
          "command"
        ]
      },
      {
        "id": "com.getsayall.candidate.deepseek-harness-ten-key.ok",
        "displayName": "回车 / 发送",
        "keyCode": 36,
        "keyLabel": "Return",
        "modifiers": []
      },
      {
        "id": "com.getsayall.candidate.deepseek-harness-ten-key.back",
        "displayName": "删除字符",
        "keyCode": 51,
        "keyLabel": "Backspace",
        "modifiers": []
      },
      {
        "id": "com.getsayall.candidate.deepseek-harness-ten-key.volume-up",
        "displayName": "向上翻页",
        "keyCode": 116,
        "keyLabel": "Page Up",
        "modifiers": []
      },
      {
        "id": "com.getsayall.candidate.deepseek-harness-ten-key.volume-down",
        "displayName": "向下翻页",
        "keyCode": 121,
        "keyLabel": "Page Down",
        "modifiers": []
      },
      {
        "id": "com.getsayall.candidate.deepseek-harness-ten-key.power",
        "displayName": "停止当前任务",
        "keyCode": 47,
        "keyLabel": ".",
        "modifiers": [
          "command"
        ]
      }
    ],
    "focusTargets": [],
    "applications": []
  },
  "requirements": {
    "minimumRemoteMicVersion": "1.9.21",
    "minimumReaderVersion": "1.0",
    "capabilities": []
  },
  "extensions": {
    "app.sayall:platform": {
      "platform": "macOS"
    }
  }
}
