{
  "format": "sayall-transfer",
  "website": "https://sayall.app/market/",
  "github": "https://github.com/GetSayAll/sayall-market",
  "packageID": "com.getsayall.candidate.wechat-ten-key",
  "version": "0.1.2",
  "exportPurpose": "share",
  "schemaVersion": "1.0",
  "type": "buttonProfile",
  "profile": {
    "id": "com.getsayall.candidate.wechat-ten-key",
    "name": "微信 10键",
    "remoteModel": "xiaomi-remote-2-pro",
    "mode": "automatic",
    "applicationBundleIdentifiers": [
      "com.tencent.xinWeChat"
    ],
    "bindings": [
      {
        "controlID": "up",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.wechat-ten-key.up"
        }
      },
      {
        "controlID": "down",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.wechat-ten-key.down"
        }
      },
      {
        "controlID": "left",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.wechat-ten-key.left"
        }
      },
      {
        "controlID": "right",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.wechat-ten-key.right"
        }
      },
      {
        "controlID": "ok",
        "gesture": "singlePress",
        "target": {
          "kind": "host",
          "actionID": "returnKey"
        }
      },
      {
        "controlID": "back",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.wechat-ten-key.back"
        }
      },
      {
        "controlID": "home",
        "gesture": "singlePress",
        "target": {
          "kind": "disabled"
        }
      },
      {
        "controlID": "volume-up",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.wechat-ten-key.volume-up"
        }
      },
      {
        "controlID": "volume-down",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.wechat-ten-key.volume-down"
        }
      },
      {
        "controlID": "power",
        "gesture": "singlePress",
        "target": {
          "kind": "shortcut",
          "referenceID": "com.getsayall.candidate.wechat-ten-key.power"
        }
      }
    ]
  },
  "dependencies": {
    "macros": [],
    "shortcuts": [
      {
        "id": "com.getsayall.candidate.wechat-ten-key.up",
        "displayName": "光标上移 / 列表上一项",
        "keyCode": 126,
        "keyLabel": "↑",
        "modifiers": []
      },
      {
        "id": "com.getsayall.candidate.wechat-ten-key.down",
        "displayName": "光标下移 / 列表下一项",
        "keyCode": 125,
        "keyLabel": "↓",
        "modifiers": []
      },
      {
        "id": "com.getsayall.candidate.wechat-ten-key.left",
        "displayName": "光标左移",
        "keyCode": 123,
        "keyLabel": "←",
        "modifiers": []
      },
      {
        "id": "com.getsayall.candidate.wechat-ten-key.right",
        "displayName": "光标右移",
        "keyCode": 124,
        "keyLabel": "→",
        "modifiers": []
      },
      {
        "id": "com.getsayall.candidate.wechat-ten-key.back",
        "displayName": "删除字符",
        "keyCode": 51,
        "keyLabel": "Backspace",
        "modifiers": []
      },
      {
        "id": "com.getsayall.candidate.wechat-ten-key.volume-up",
        "displayName": "向上翻页",
        "keyCode": 116,
        "keyLabel": "Page Up",
        "modifiers": []
      },
      {
        "id": "com.getsayall.candidate.wechat-ten-key.volume-down",
        "displayName": "向下翻页",
        "keyCode": 121,
        "keyLabel": "Page Down",
        "modifiers": []
      },
      {
        "id": "com.getsayall.candidate.wechat-ten-key.power",
        "displayName": "隐藏窗口",
        "keyCode": 4,
        "keyLabel": "H",
        "modifiers": [
          "command"
        ]
      }
    ],
    "focusTargets": [],
    "applications": []
  },
  "requirements": {
    "minimumRemoteMicVersion": "1.9.21",
    "minimumReaderVersion": "1.0",
    "capabilities": []
  },
  "extensions": {
    "app.sayall:platform": {
      "platform": "macOS"
    }
  }
}
